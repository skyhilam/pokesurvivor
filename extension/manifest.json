{
  "manifest_version": 3,
  "name": "PokéSurvivor Jev Strategic Bot",
  "version": "1.0.0",
  "description": "Hybrid 60fps reflex engine + TypeSafe Jev strategic brain for PokéSurvivor",
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PokéSurvivor Jev Bot"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://pokesurvivor.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pokesurvivor.com/*",
        "https://*.pokesurvivor.com/*"
      ],
      "js": [
        "content_bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://pokesurvivor.com/*",
        "https://*.pokesurvivor.com/*"
      ],
      "js": [
        "page_agent.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
